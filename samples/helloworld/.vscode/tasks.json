{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": [
                "DEBUG=1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "scp",
            "args": [
                "helloworld",
                "${config:helloworld.user}@${config:helloworld.remoteHost}:${config:helloworld.remoteDir}/helloworld"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "start remote gdbserver",
            "type": "shell",
            "command": "ssh",
            "args": [
                "${config:helloworld.user}@${config:helloworld.remoteHost}",
                "killall -9 gdbserver > /dev/null 2>&1; chmod +x ${config:helloworld.remoteDir}/helloworld; gdbserver --once :${config:helloworld.port} ${config:helloworld.remoteDir}/helloworld"
            ],
            "dependsOn": "deploy",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^Listening on port \\d+$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Listening on port",
                    "endsPattern": "Listening on port"
                }
            }
        }
    ]
}