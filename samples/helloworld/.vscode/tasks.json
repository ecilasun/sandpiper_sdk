{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": [
                "DEBUG=1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "scp",
            "args": [
                "helloworld",
                "peta@192.168.1.87:/home/peta/helloworld"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "start remote gdbserver",
            "type": "shell",
            "command": "ssh",
            "args": [
                "peta@192.168.1.87",
                "killall -9 gdbserver > /dev/null 2>&1; chmod +x /home/peta/helloworld; gdbserver --once :2000 /home/peta/helloworld"
            ],
            "dependsOn": "deploy",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^Listening on port \\d+$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Listening on port",
                    "endsPattern": "Listening on port"
                }
            }
        }
    ]
}