import os
import platform

VERSION = '0.1'
APPNAME = 'vcpcompiler'

top = '.'


def options(opt):
    opt.add_option(
        '--toolchain',
        action='store',
        default='auto',
        help='Toolchain to use: auto|msvc|gcc|clang (default: auto)')

    # Load tool options so flags like --check-cxx-compiler are available.
    # Actual selection happens in configure().
    if platform.system().lower().startswith('win'):
        opt.load('msvc')
        opt.load('clang++')
        opt.load('g++')
    else:
        opt.load('clang++')
        opt.load('g++')


def _load_toolchain(conf):
    tc = (conf.options.toolchain or 'auto').lower()

    def try_load(name):
        try:
            conf.load(name)
            return True
        except Exception:
            return False

    is_win = platform.system().lower().startswith('win')

    if tc == 'msvc':
        if is_win:
            conf.env.MSVC_TARGETS = ['x64']
        conf.load('msvc')
        return
    if tc == 'gcc':
        conf.load('g++')
        return
    if tc == 'clang':
        conf.load('clang++')
        return

    # auto
    if is_win:
        if try_load('msvc'):
            return
        if try_load('clang++'):
            return
        conf.load('g++')
        return

    # non-Windows
    if try_load('clang++'):
        return
    conf.load('g++')


def configure(conf):
    _load_toolchain(conf)


def build(bld):
    is_msvc = bld.env.CXX_NAME == 'msvc'

    if is_msvc:
        cxxflags = ['/nologo', '/std:c++17', '/EHsc', '/O2', '/W4']
    else:
        cxxflags = ['-std=c++17', '-O2', '-Wall', '-Wextra', '-Wpedantic']

    bld.program(
        source=['src/main.cpp'],
        target='vcpcompiler',
        cxxflags=cxxflags,
        use=[])

    # Convenience copy to ./bin (matches other host tools layout)
    out_name = 'vcpcompiler.exe' if platform.system().lower().startswith('win') else 'vcpcompiler'
    bld(features='subst', source=out_name, target=os.path.abspath(os.path.join('bin', out_name)), is_copy=True)
